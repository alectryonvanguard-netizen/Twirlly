<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CyberLab" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#05060A</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.CyberLab.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#05060A</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.CyberLab</item>
    </style>
</resources>
